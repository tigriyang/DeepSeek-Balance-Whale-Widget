<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.dsh.whalefloat</string>

    <!-- 直接启动 app bundle 内的可执行文件。
         不用 open -a 是为了让 launchd 直接持有进程句柄，
         崩溃后 KeepAlive 才能可靠拉起。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/WhaleFloat.app/Contents/MacOS/WhaleFloat</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <!-- 只在本程序**异常退出**（崩溃）时自动拉起；正常退出（菜单「退出」或 Cmd+Q）
         不再自启。
         之前这里写的是 <true/>，含义是「无论如何都保持运行」—— 于是退出后
         过一会儿又被 launchd 拉回来，看起来就像「起停没做好、自己又起来了」。 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- 程序不存在时自动卸载本配置。
         这条是「拖到废纸篓即卸载」的关键：用户把 app 拖进废纸篓后，
         路径消失，launchd 会自己停掉并卸下这个 job ——
         否则 KeepAlive 会一直尝试拉起一个不存在的程序，日志刷错误。 -->
    <key>PathState</key>
    <dict>
        <key>/Applications/WhaleFloat.app</key>
        <true/>
    </dict>

    <!-- GUI 程序必须在用户图形会话里跑 -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/tmp/whalefloat.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/whalefloat.log</string>
</dict>
</plist>